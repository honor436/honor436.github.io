#!/bin/sh
# 코드 변경을 커밋할 때 graphify 지식 그래프(graphify-out/)를 재빌드해 같은 커밋에 포함한다.
# AST 기반이라 LLM·API 키가 필요 없다. 문서(.html/.md) 의미 추출은 /graphify --update 로 수동 갱신.
# 건너뛰기: GRAPHIFY_SKIP_HOOK=1 git commit ...

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0
[ -f graphify-out/graph.json ] || exit 0

# graphify-out/ 외의 변경이 없으면 재빌드 불필요
STAGED=$(git diff --cached --name-only | grep -v '^graphify-out/' || true)
[ -z "$STAGED" ] && exit 0

if [ -x "$(cat graphify-out/.graphify_python 2>/dev/null)" ]; then
    GRAPHIFY="$(cat graphify-out/.graphify_python) -m graphify"
elif command -v graphify >/dev/null 2>&1; then
    GRAPHIFY="graphify"
elif [ -x "$HOME/.local/bin/graphify" ]; then
    GRAPHIFY="$HOME/.local/bin/graphify"
else
    echo "[graphify] graphify 미설치 - 그래프 갱신을 건너뜁니다 (uv tool install graphifyy)" >&2
    exit 0
fi

echo "[graphify] 그래프 갱신 중..."
if PYTHONHASHSEED=0 GRAPHIFY_NO_TIPS=1 $GRAPHIFY update . >/dev/null 2>&1; then
    git add graphify-out/graph.json graphify-out/graph.html graphify-out/GRAPH_REPORT.md \
            graphify-out/manifest.json graphify-out/.graphify_labels.json \
            graphify-out/.graphify_labels.json.sig 2>/dev/null
    echo "[graphify] graphify-out/ 갱신분을 커밋에 포함했습니다."
else
    echo "[graphify] 그래프 갱신 실패 - 커밋은 계속 진행합니다 (수동: graphify update .)" >&2
fi
exit 0
